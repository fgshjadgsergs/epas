# Application
NODE_ENV=development
# Прикладное окружение стенда: development | staging | production.
# Публичный демо-стенд = APP_ENV=staging + NODE_ENV=production.
APP_ENV=development
# Демонстрационные цены. В staging включаются явно, при APP_ENV=production
# приложение с этим флагом не стартует.
ALLOW_DEMO_PRICING=false
PORT=3000
API_PREFIX=api/v1
# В production обязателен (конкретный origin, не "*") — иначе старт упадёт, см. env.validation.ts
CORS_ORIGIN=http://localhost:3001

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photo_print?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=photo-print
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/photo-print

# Files
# 15 MiB default. Keep in sync with the hard ceiling in FilesController and
# with any reverse-proxy / ingress body-size limit in front of this service.
FILES_MAX_SIZE_BYTES=15728640
FILES_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Rate limiting
# Общий (каталожный) лимит — намеренно высокий: GET /categories, /services
# читаются на каждой странице при `next build` (сотни статических страниц).
# /calculate и /calculate/confirm имеют отдельный жёсткий лимит 60/мин,
# заданный прямо в CalculatorController через @Throttle (ТЗ §15.3).
THROTTLE_TTL=60
THROTTLE_LIMIT=1200

# true — за доверенным reverse-proxy (nginx на сервере), иначе throttler
# и любой код, читающий req.ip, видят адрес proxy, а не клиента.
TRUST_PROXY=false

# Seed (dev only — override before running seed against a shared/prod DB)
SEED_ADMIN_EMAIL=admin@photo-print.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Frontend в Docker (профиль "frontend"). Обе переменные зашиваются в бандл
# на этапе next build — после изменения фронт нужно пересобрать.
FRONTEND_API_URL=http://localhost:3000/api/v1
# Fallback-пометка о демонстрационных ценах (на staging — true).
FRONTEND_DEMO_PRICING=false
